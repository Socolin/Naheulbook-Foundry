<div class="naheulbook-monster-sheet">
    <header class="sheet-header">
        <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
        <div class="header-fields">
            <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></h1>
            <div class="resource health">
                <span>Énergie vitale</span>
                <input type="text" name="system.ev.value" value="{{actor.system.ev.value}}" data-dtype="Number"/>
                <span> / </span>
                <input type="text" name="system.ev.max" value="{{actor.system.ev.max}}" data-dtype="Number"
                       {{#if isSynced}}disabled{{/if}} />
            </div>
            <div class="resource mana">
                <span>Énergie astrale</span>
                <input type="text" name="system.ea.value" value="{{actor.system.ea.value}}" data-dtype="Number"/>
                <span> / </span>
                <input type="text" name="system.ea.max" value="{{actor.system.ea.max}}" data-dtype="Number"
                       {{#if isSynced}}disabled{{/if}} />
            </div>
        </div>
    </header>

    <nav class="sheet-tabs tabs" data-group="primary">
        {{#each tabs as |tab|}}
            <a class="item {{tab.cssClass}}" data-action="tab" data-group="primary" data-tab="{{tab.id}}">{{tab.label}}</a>
        {{/each}}
    </nav>

    <section class="sheet-body">
        <div class="tab attributes {{tabs.attributes.cssClass}}" data-group="primary" data-tab="attributes">
            {{#each statsByGroup as |statGroup|}}
                <section class="{{@key}}">
                    <h3>{{statGroup.label}}</h3>
                    <section class="stats">
                        {{#each statGroup.stats as |stat|}}
                            <div class="attribute" data-stat-display-name="{{stat.name}}" data-stat-name="{{stat.stat}}">
                                <span class="label">{{stat.name}} <span class="shortName">({{stat.stat}})</span></span>
                                <input class="value" type="text" name="system.{{stat.stat}}" value="{{lookup ../../actor.system stat.stat}}"
                                       data-dtype="Number" {{#if ../../isSynced}}disabled{{/if}}/>
                                {{#if stat.canUseForSkill}}
                                    <span class="actions">
                                        <a data-action="rollStat" title="Lancer les dé"><i class="fa fa-dice"></i></a>
                                        <a data-action="createStatMacro" title="Créer une macro"><i class="fa fa-cog"></i></a>
                                    </span>
                                {{/if}}
                            </div>
                        {{/each}}
                    </section>
                </section>
                {{#if (not @last)}}
                    <div class="separator"></div>
                {{/if}}
            {{/each}}
        </div>
        <div class="tab naheulbook {{tabs.naheulbook.cssClass}}" data-group="primary" data-tab="naheulbook">
            <div class="attribute">
                <span>Naheulbook Id (Monstre):</span>
                <input type="text" name="system.naheulbookMonsterId" value="{{actor.system.naheulbookMonsterId}}"
                       data-dtype="Number" {{#unless isGm}}disabled{{/unless}} />
            </div>
        </div>
    </section>
</div>
